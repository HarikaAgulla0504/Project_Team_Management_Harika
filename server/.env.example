# Copy to .env and fill in. NEVER commit the real .env file.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pm_system?schema=public"

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_SECONDS=86400

# Where the React dev server runs (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Cost factor for bcrypt password hashing (10-12 is typical)
BCRYPT_ROUNDS=12

# Used only by `npm run db:seed` to create the initial admin account
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
