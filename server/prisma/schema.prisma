generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  TEAM_MEMBER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

// Declared lowest -> highest so ORDER BY priority sorts logically.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(TEAM_MEMBER)
  // Users are deactivated instead of deleted so history (comments, activity) stays intact.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  assignedTasks Task[]          @relation("TaskAssignee")
  createdTasks  Task[]          @relation("TaskCreator")
  comments      TaskComment[]
  activities    ActivityLog[]

  @@index([role])
}

model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String        @default("")
  startDate   DateTime
  deadline    DateTime
  status      ProjectStatus @default(PLANNING)
  ownerId     Int
  // Soft delete: archived projects are hidden from lists but keep their data.
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner    User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members  ProjectMember[]
  tasks    Task[]
  activity ActivityLog[]

  @@index([ownerId])
  @@index([status])
  @@index([archivedAt])
}

// Join table: many users <-> many projects.
model ProjectMember {
  projectId Int
  userId    Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite primary key = a user can only be added to a project once.
  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String       @default("")
  projectId   Int
  assigneeId  Int?
  createdById Int
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  comments  TaskComment[]
  activity  ActivityLog[]

  // Indexes match the columns we filter / sort by most often.
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([priority])
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  projectId Int
  // Nullable + SetNull: the log line survives after a task is deleted.
  taskId    Int?
  actorId   Int
  action    String
  details   Json?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
}
